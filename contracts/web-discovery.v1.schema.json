{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerivo.net/geo/contracts/web-discovery.v1.schema.json",
  "title": "Peerivo GEO Web Discovery Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "canonicalHost"],
  "properties": {
    "version": { "const": "peerivo-geo/web-discovery/v1" },
    "profile": {
      "enum": ["public_required", "public_limited", "restricted", "not_applicable"]
    },
    "canonicalHost": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9.-]+(?::[0-9]+)?$"
    },
    "sitemap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "indexNow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "keyEnv": { "type": "string", "default": "INDEXNOW_KEY" },
        "keyLocation": { "type": "string", "format": "uri" },
        "triggers": {
          "type": "array",
          "items": { "enum": ["created", "updated", "deleted"] },
          "uniqueItems": true,
          "default": ["created", "updated", "deleted"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": { "enum": ["restricted", "not_applicable"] }
        }
      },
      "then": {
        "properties": {
          "indexNow": {
            "properties": { "enabled": { "const": false } }
          }
        }
      }
    }
  ]
}
